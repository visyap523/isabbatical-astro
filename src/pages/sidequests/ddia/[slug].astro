---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('ddia');
  return chapters.map(chapter => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---

<Layout
  title={chapter.data.title}
  description={chapter.data.summary}
  currentPage="sidequests"
  url={`https://isabbatical.net/sidequests/ddia/${chapter.id}`}
>

  <a href="/sidequests/ddia" class="back-link">← DDIA Notes</a>

  <header class="chapter-header">
    <span class="chapter-number">Chapter {chapter.data.chapter}</span>
    <h1 class="chapter-title">{chapter.data.title}</h1>
    <p class="chapter-date">{chapter.data.date}</p>
  </header>

  <article class="chapter-body">
    <Content />
  </article>

</Layout>

<style is:global>
  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--ink-light);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent); }

  .chapter-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .chapter-number {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-light);
    margin-bottom: 0.5rem;
  }

  .chapter-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .chapter-date {
    font-size: 0.8rem;
    color: var(--ink-light);
  }

  /* Section headings — match About page label style */
  .chapter-body h2 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-light);
    margin-bottom: 0.5rem;
    margin-top: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .chapter-body h2:first-child {
  border-top: none;
  padding-top: 0;
}

  /* Spacing between sections */
  .chapter-body h2 + ul {
    margin-top: 0;
  }

  .chapter-body > * + h2 {
    margin-top: 1.5rem;
  }

  /* Body text */
  .chapter-body p {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: 0.85rem;
  }

  /* Top-level bullets — match About page ▸ style */
  .chapter-body ul {
    list-style: none;
    margin: 0.25rem 0 0.5rem 0;
  }

  .chapter-body ul li {
    font-size: 0.85rem;
    color: var(--ink);
    padding: 0.1rem 0 0.1rem 1.25rem;
    position: relative;
    line-height: 1.7;
  }

  .chapter-body ul li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--ink-light);
    font-size: 0.9rem;
  }

  /* Nested bullets — match About page > style */
  .chapter-body ul ul {
    margin-top: 0.25rem;
    margin-left: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .chapter-body ul ul li::before {
    content: '>';
    font-size: 0.8rem;
  }

  /* Triple nested */
  .chapter-body ul ul ul {
    margin-top: 0.25rem;
    margin-left: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .chapter-body ul ul ul li::before {
    content: '–';
    font-size: 0.8rem;
  }

  .chapter-body strong {
    font-weight: 600;
    color: var(--ink);
  }

  .chapter-body em {
    font-style: italic;
  }
</style>