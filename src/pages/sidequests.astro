---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sidequests" description="Witness me as I walk around my city, horf down protein, and improve my pharyngeal resonance." currentPage="sidequests" url="https://isabbatical.net/sidequests">

  <header class="page-header">
    <h1>Sidequests</h1>
    <p>Witness me as I walk around <a href="/sidequests/new-york">my city</a>, horf down protein, and improve my pharyngeal resonance. Coming soon.</p>
  </header>

</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 0.9rem;
    color: var(--ink-light);
  }

  p a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  p a:hover {
    text-decoration-color: var(--accent);
  }
</style>