---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const db = env.henro_db;

// Fetch all temples
const { results: temples } = await db.prepare(
  "SELECT * FROM temples ORDER BY number"
).all();

// Fetch visited temple numbers
const { results: visits } = await db.prepare(
  "SELECT DISTINCT temple_number FROM temple_visits"
).all();

const visitedSet = new Set(visits.map(v => v.temple_number));

// Group by prefecture
const prefectures = ['Tokushima', 'Kochi', 'Ehime', 'Kagawa'];
const grouped = prefectures.map(pref => ({
  name: pref,
  temples: temples.filter(t => t.prefecture === pref)
}));

const prefectureLabels = {
  Tokushima: 'Awakening',
  Kochi: 'Ascetic Training',
  Ehime: 'Enlightenment',
  Kagawa: 'Nirvana'
};
---

<Layout
  title="Temples — Henro"
  description="All 88 temples of the Shikoku Henro."
  currentPage="sidequests"
  url="https://isabbatical.net/henro/temples"
>

  <a href="/henro" class="back-link">← Henro</a>

  <header class="page-header">
    <h1>Temples</h1>
    <p>All 88 temples of the Shikoku pilgrimage.</p>
  </header>

  <!-- SEARCH + FILTER -->
  <div class="controls">
    <input
      type="text"
      id="search"
      placeholder="Search temples..."
      class="search-input"
    />
    <div class="filter-bar">
  <button class="filter-btn active" data-filter="all">All</button>
  {prefectures.map(pref => (
    <button class="filter-btn" data-filter={pref}>{pref}</button>
  ))}
  <button class="filter-btn" data-filter="visited">Visited</button>
  <button class="filter-btn" data-filter="unvisited">Not visited</button>
</div>
  </div>

  <!-- TEMPLE LIST -->
  <div class="temple-list" id="temple-list">
    {grouped.map(group => (
      <div class="prefecture-group" data-prefecture={group.name}>
        <div class="prefecture-header">
          <h2 class="prefecture-name">{group.name}</h2>
          <span class="prefecture-label">{prefectureLabels[group.name]}</span>
          <span class="prefecture-count">
            {group.temples.filter(t => visitedSet.has(t.number)).length}/{group.temples.length}
          </span>
        </div>

        {group.temples.map(temple => (
          <div
            class={`temple-row ${visitedSet.has(temple.number) ? 'visited' : ''}`}
            data-name={temple.name_en.toLowerCase()}
            data-prefecture={temple.prefecture}
          >
            <div class="temple-image-wrap">
              {temple.image_url ? (
                <img
                  src={`https://commons.wikimedia.org/wiki/Special:FilePath/${temple.image_url.split('File:')[1]}?width=80`}
                  alt={temple.name_en}
                  class="temple-img"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
                />
              ) : null}
              <div class="temple-img-fallback" style="display:none">
                ⛩️
              </div>
            </div>

            <div class="temple-info">
              <div class="temple-name-row">
                <span class="temple-number">{temple.number}</span>
                <span class="temple-name-en">{temple.name_en}</span>
                <span class="temple-name-jp">{temple.name_jp}</span>
              </div>
              <div class="temple-meta">
                <span>{temple.deity}</span>
                {temple.km_from_previous > 0 && (
                  <span>{temple.km_from_previous}km from previous</span>
                )}
              </div>
            </div>

            <form method="POST" action="/api/visit" class="visit-form">
              <input type="hidden" name="temple_number" value={temple.number} />
              <input type="hidden" name="action" value={visitedSet.has(temple.number) ? 'unvisit' : 'visit'} />
              <button
                type="submit"
                class={`visit-btn ${visitedSet.has(temple.number) ? 'visited' : ''}`}
                title={visitedSet.has(temple.number) ? 'Mark unvisited' : 'Mark visited'}
              >
                {visitedSet.has(temple.number) ? '✓' : '○'}
              </button>
            </form>
          </div>
        ))}
      </div>
    ))}
  </div>

</Layout>

<script>
  // Search
  const search = document.getElementById('search');
  const rows = document.querySelectorAll('.temple-row');
  const groups = document.querySelectorAll('.prefecture-group');

  search.addEventListener('input', () => {
    const query = search.value.toLowerCase().trim();
    rows.forEach(row => {
      const name = row.dataset.name;
      row.style.display = name.includes(query) ? 'flex' : 'none';
    });
    // Hide empty groups
    groups.forEach(group => {
      const visible = [...group.querySelectorAll('.temple-row')]
        .some(r => r.style.display !== 'none');
      group.style.display = visible ? 'block' : 'none';
    });
  });

  // Prefecture filter
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;

    groups.forEach(group => group.style.display = 'block');
    search.value = '';

    rows.forEach(row => {
      if (filter === 'all') {
        row.style.display = 'flex';
      } else if (filter === 'visited') {
        row.style.display = row.classList.contains('visited') ? 'flex' : 'none';
      } else if (filter === 'unvisited') {
        row.style.display = row.classList.contains('visited') ? 'none' : 'flex';
      } else {
        row.style.display = row.dataset.prefecture === filter ? 'flex' : 'none';
      }
    });

    // Hide empty groups
    groups.forEach(group => {
      const visible = [...group.querySelectorAll('.temple-row')]
        .some(r => r.style.display !== 'none');
      group.style.display = visible ? 'block' : 'none';
    });
  });
});

// Handle visit form submissions without page reload
document.querySelectorAll('.visit-form').forEach(form => {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const btn = form.querySelector('.visit-btn');
    const row = form.closest('.temple-row');
    const isVisiting = formData.get('action') === 'visit';

    await fetch('/api/visit', {
      method: 'POST',
      body: formData
    });

    // Update button + row
    if (isVisiting) {
      btn.textContent = '✓';
      btn.classList.add('visited');
      form.querySelector('[name="action"]').value = 'unvisit';
      row.classList.add('visited');
    } else {
      btn.textContent = '○';
      btn.classList.remove('visited');
      form.querySelector('[name="action"]').value = 'visit';
      row.classList.remove('visited');
    }

    // Update prefecture count
    const prefecture = row.dataset.prefecture;
    const group = document.querySelector(`.prefecture-group[data-prefecture="${prefecture}"]`);
    const countEl = group.querySelector('.prefecture-count');
    const total = group.querySelectorAll('.temple-row').length;
    const visited = group.querySelectorAll('.temple-row.visited').length;
    countEl.textContent = `${visited}/${total}`;
  });
});
</script>

<style is:global>
  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--ink-light);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent); }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 0.9rem;
    color: var(--ink-light);
  }

  /* CONTROLS */
  .controls {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-input {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    background: white;
    border: 1px solid var(--border);
    color: var(--ink);
    padding: 0.6rem 0.9rem;
    border-radius: 2px;
    width: 100%;
    transition: border-color 0.2s;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-light);
    border: 1px solid var(--border);
    background: transparent;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* PREFECTURE GROUP */
  .prefecture-group {
    margin-bottom: 2.5rem;
  }

  .prefecture-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }

  .prefecture-name {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-light);
  }

  .prefecture-label {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-light);
  }

  .prefecture-count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--ink-light);
  }

  /* TEMPLE ROW */
  .temple-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s;
  }

  .temple-row.visited {
    opacity: 0.5;
  }

  /* IMAGE */
  .temple-image-wrap {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 3px;
    overflow: hidden;
    background: var(--border);
  }

  .temple-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .temple-img-fallback {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  /* TEMPLE INFO */
  .temple-info {
    flex: 1;
    min-width: 0;
  }

  .temple-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
    flex-wrap: wrap;
  }

  .temple-number {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-light);
    min-width: 1.5rem;
  }

  .temple-name-en {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }

  .temple-name-jp {
    font-size: 0.8rem;
    color: var(--ink-light);
  }

  .temple-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--ink-light);
  }

  /* VISIT BUTTON */
  .visit-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--ink-light);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .visit-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .visit-btn.visited {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  @media (max-width: 600px) {
    .temple-image-wrap { display: none; }
    .temple-meta { flex-direction: column; gap: 0.1rem; }
  }
</style>