---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

import { env } from 'cloudflare:workers';
const db = env.henro_db;

// Get total temples visited
const visitResult = await db.prepare(
  "SELECT COUNT(DISTINCT temple_number) as count FROM temple_visits"
).first();

const visited = visitResult?.count ?? 0;
const total = 88;
const percent = Math.round((visited / total) * 100);

// Get the four prefectures with progress
const prefectures = [
  { name: 'Tokushima', label: 'Awakening', temples: 23 },
  { name: 'Kochi', label: 'Ascetic Training', temples: 16 },
  { name: 'Ehime', label: 'Enlightenment', temples: 26 },
  { name: 'Kagawa', label: 'Nirvana', temples: 23 },
];

const prefectureProgress = await Promise.all(
  prefectures.map(async (pref) => {
    const result = await db.prepare(`
      SELECT COUNT(DISTINCT tv.temple_number) as count
      FROM temple_visits tv
      JOIN temples t ON tv.temple_number = t.number
      WHERE t.prefecture = ?
    `).bind(pref.name).first();
    return { ...pref, visited: result?.count ?? 0 };
  })
);
---

<Layout
  title="Shikoku Henro"
  description="Planning and tracking my Shikoku pilgrimage."
  currentPage="sidequests"
  url="https://isabbatical.net/henro"
>

  <header class="page-header">
    <h1>Shikoku Henro</h1>
    <p>88 temples. 1,200km. October–November 2026.</p>
  </header>

  <!-- PROGRESS OVERVIEW -->
  <section class="progress-section">
    <div class="progress-header">
      <span class="progress-label">Overall progress</span>
      <span class="progress-count">{visited} / {total} temples</span>
    </div>
    <div class="progress-bar-track">
      <div class="progress-bar-fill" style={`width: ${percent}%`}></div>
    </div>
  </section>

  <!-- PREFECTURE BREAKDOWN -->
  <section class="prefecture-section">
    {prefectureProgress.map(pref => (
      <div class="prefecture-row">
        <div class="prefecture-info">
          <span class="prefecture-name">{pref.name}</span>
          <span class="prefecture-label">{pref.label}</span>
        </div>
        <div class="prefecture-bar-track">
          <div
            class="prefecture-bar-fill"
            style={`width: ${Math.round((pref.visited / pref.temples) * 100)}%`}
          ></div>
        </div>
        <span class="prefecture-count">{pref.visited}/{pref.temples}</span>
      </div>
    ))}
  </section>

  <!-- NAV CARDS -->
  <div class="henro-nav">
    <a href="/henro/temples" class="henro-card">
      <span class="henro-card-emoji">⛩️</span>
      <h2>Temples</h2>
      <p>All 88 temples. Check them off as you go.</p>
    </a>
    <a href="/henro/pack" class="henro-card">
      <span class="henro-card-emoji">🎒</span>
      <h2>Packing list</h2>
      <p>Everything you need on the trail.</p>
    </a>
  </div>

</Layout>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 0.9rem;
    color: var(--ink-light);
  }

  /* PROGRESS */
  .progress-section {
    background: #FEFCF5;
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .progress-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-light);
  }

  .progress-count {
    font-size: 0.85rem;
    color: var(--ink);
    font-family: var(--font-serif);
  }

  .progress-bar-track {
    width: 100%;
    height: 4px;
    background: var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.3s ease;
    min-width: 2px;
  }

  /* PREFECTURES */
  .prefecture-section {
    background: #FEFCF5;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .prefecture-row {
    display: grid;
    grid-template-columns: 10rem 1fr 3rem;
    align-items: center;
    gap: 1rem;
  }

  .prefecture-info {
    display: flex;
    flex-direction: column;
  }

  .prefecture-name {
    font-size: 0.85rem;
    color: var(--ink);
    font-weight: 500;
  }

  .prefecture-label {
    font-size: 0.7rem;
    color: var(--ink-light);
    font-style: italic;
  }

  .prefecture-bar-track {
    height: 3px;
    background: var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .prefecture-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    min-width: 2px;
  }

  .prefecture-count {
    font-size: 0.75rem;
    color: var(--ink-light);
    text-align: right;
  }

  /* NAV CARDS */
  .henro-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .henro-card {
    background:#FEFCF5;
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .henro-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .henro-card-emoji {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .henro-card h2 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .henro-card p {
    font-size: 0.85rem;
    color: var(--ink-light);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .henro-nav { grid-template-columns: 1fr; }
    .prefecture-row { grid-template-columns: 8rem 1fr 2.5rem; }
  }
</style>